{
  "name": "gift-homes-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:web": "pnpm --filter @gift-homes/web run dev",
    "dev:api": "pnpm --filter @gift-homes/api run dev",
    "build": "pnpm --recursive run build",
    "build:web": "pnpm --filter @gift-homes/web run build",
    "build:api": "pnpm --filter @gift-homes/api run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --filter @gift-homes/web run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
